# Meta App configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0

# Short-lived User Token from Graph API Explorer → run scripts/refresh_all_tokens.py
# After refresh this holds the long-lived user token (~60 days)
META_USER_ACCESS_TOKEN=replace_with_long_lived_user_token

# Target Facebook Page and linked Instagram Business account
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=replace_with_page_access_token
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Application settings
APP_ENV=development
APP_DEBUG=true
# Local / Render free default (ephemeral on Render redeploys).
# Week reports and content descriptions are rows in this same file.
# Point this at a lasting disk only after that disk exists. Do not invent a mount.
DATABASE_PATH=data/social_search.db
SYNC_PAGE_SIZE=100
# Business Discovery media.limit per HTTP call (default 25). Larger is not assumed cheaper.
DISCOVERY_MEDIA_PAGE_SIZE=25
REQUEST_TIMEOUT_SECONDS=30

# Shared secret for GET /internal/growth-tick. The Streamlit page is not a tick.
# GROWTH_TICK_SECRET=

# Private snapshot repository. Never set this to SandrinePr/Meta-Dashboard.
# GITHUB_SNAPSHOT_REPO=
# GITHUB_SNAPSHOT_BRANCH=durable-snapshot
# GITHUB_SNAPSHOT_TOKEN=

# Local image test for Gemini 3.5 Flash-Lite.
# The app calls {AI_BASE_URL}/chat/completions. Put the secret only in .env.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# AI_API_KEY=
